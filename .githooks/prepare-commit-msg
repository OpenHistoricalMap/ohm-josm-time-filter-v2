#!/bin/sh
# Append `Co-Authored-By: Claude <noreply@anthropic.com>` to every commit
# message that doesn't already contain it.
#
# Activate per-clone with:
#   git config core.hooksPath .githooks
#
# This complements `git config commit.template .gitmessage`, which only
# applies to interactive `git commit` (no -m). The hook below covers the
# `-m`, `-F`, and amend paths too.

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Don't append for these sources — git supplies its own message text or
# the user is editing an existing commit's message.
case "$COMMIT_SOURCE" in
    merge|squash) exit 0 ;;
esac

TRAILER="Co-Authored-By: Claude <noreply@anthropic.com>"

# Refuse to "enrich" an empty message. Otherwise git would promote the
# trailer line to a commit subject, leaving a stub with no real text.
# A line counts as content if it's not a git-comment (starts with #) and
# not just whitespace. The `! grep` trick: exit early when grep finds no
# qualifying line.
if ! grep -v -E '^(#|[[:space:]]*$)' "$COMMIT_MSG_FILE" >/dev/null 2>&1; then
    exit 0
fi

# Already present (template, amend, or manual entry)? Nothing to do.
if grep -qF "$TRAILER" "$COMMIT_MSG_FILE"; then
    exit 0
fi

# Append trailer with a blank line separator. Pure cat + printf — no sed
# pattern syntax to worry about across BSD vs GNU.
TMP="$(mktemp)"
{
    cat "$COMMIT_MSG_FILE"
    printf '\n%s\n' "$TRAILER"
} > "$TMP"
mv "$TMP" "$COMMIT_MSG_FILE"
